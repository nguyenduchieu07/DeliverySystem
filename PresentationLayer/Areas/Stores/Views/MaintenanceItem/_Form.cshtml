@model MaintenanceItemEditVM

<div class="mb-3">
    <label class="form-label">Tên loại bảo trì <span class="text-danger">*</span></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label">Mô tả</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>

<div class="mb-3">
    <label class="form-label">Thời lượng ước tính (phút) <span class="text-danger">*</span></label>
    <input asp-for="EstimatedDurationMinutes" type="number" class="form-control" min="1" max="1440" />
    <span asp-validation-for="EstimatedDurationMinutes" class="text-danger"></span>
</div>

<div class="mb-3 form-check">
    <input asp-for="RequireShutdown" class="form-check-input" />
    <label asp-for="RequireShutdown" class="form-check-label">Cần tắt/khoá slot khi bảo trì?</label>
</div>