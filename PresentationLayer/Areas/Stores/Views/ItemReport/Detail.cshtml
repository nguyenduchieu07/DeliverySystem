@model DataAccessLayer.Entities.ItemReport

@{
    ViewData["Title"] = "Chi tiết báo cáo";
}

<style>
    /* ===============================
       GLOBAL VARIABLES
    ================================== */
    :root {
        --success: #1cc88a;
        --warning: #f6c23e;
        --danger: #e74a3b;
        --info: #36b9cc;
        --white: #ffffff;
        --gray-dark: #5a5c69;
        --gray: #858796;
        --gray-border: #e3e6f0;
        --gray-bg: #f8f9fc;
        --accent: #e5501b;
    }

    /* ===============================
       PAGE HEADER
    ================================== */
    .page-header-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        gap: 1rem;
    }

    .page-header-wrapper h2 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 400;
        color: var(--gray-dark);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-header-wrapper h2 i {
        color: var(--accent);
        font-size: 1.5rem;
    }

    /* ===============================
       BACK BUTTON
    ================================== */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--white);
        color: var(--gray);
        border: 1px solid var(--gray-border);
        border-radius: 0.35rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s ease-in-out;
        white-space: nowrap;
    }

    .btn-back:hover {
        background: var(--gray-bg);
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-1px);
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .btn-back i {
        font-size: 0.875rem;
    }

    /* ===============================
       CARD STYLING
    ================================== */
    .card {
        background: var(--white);
        border: 1px solid var(--gray-border);
        border-radius: 0.35rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        transition: all 0.15s ease-in-out;
    }

    .card.shadow-sm {
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }

    .card.p-4 {
        padding: 1.5rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    /* ===============================
       CARD HEADERS
    ================================== */
    .card h4 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--gray-dark);
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--accent);
    }

    .card h4.text-secondary {
        color: var(--gray-dark) !important;
    }

    /* ===============================
       DEFINITION LIST
    ================================== */
    dl.row {
        margin-bottom: 0;
    }

    dl.row dt {
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
    }

    dl.row dd {
        font-size: 0.875rem;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        word-wrap: break-word;
    }

    dl.row dd a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.15s ease-in-out;
    }

    dl.row dd a:hover {
        color: #d26c45;
        text-decoration: underline;
    }

    /* ===============================
       IMAGE
    ================================== */
    .card img {
        max-width: 400px;
        border-radius: 0.35rem;
        border: 1px solid var(--gray-border);
        box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.1);
        transition: all 0.15s ease-in-out;
        display: block;
        margin-top: 0.75rem;
    }

    .card img:hover {
        transform: scale(1.02);
        box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.15);
    }

    /* ===============================
       TABLE STYLING
    ================================== */
    .table {
        width: 100%;
        margin-bottom: 1rem;
        color: var(--gray-dark);
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-bordered {
        border: 1px solid var(--gray-border);
        border-radius: 0.35rem;
        overflow: hidden;
    }

    .table thead {
        background: linear-gradient(180deg, var(--accent) 0%, #d26c45 100%);
    }

    .table thead th {
        padding: 1rem 1.25rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--white);
        border: none;
        vertical-align: middle;
    }

    .table tbody tr {
        background: var(--white);
        border-bottom: 1px solid var(--gray-border);
        transition: all 0.15s ease-in-out;
    }

    .table tbody tr:hover {
        background-color: var(--gray-bg);
    }

    .table tbody td {
        padding: 1rem 1.25rem;
        font-size: 0.875rem;
        color: var(--gray-dark);
        vertical-align: middle;
        border-right: 1px solid var(--gray-border);
    }

    .table tbody td:last-child {
        border-right: none;
    }

    /* ===============================
       STATUS BADGES
    ================================== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.875rem;
        border-radius: 10rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge.pending {
        background: linear-gradient(135deg, var(--warning) 0%, #f4b619 100%);
        color: var(--white);
    }

    .status-badge.approved {
        background: linear-gradient(135deg, var(--success) 0%, #17a673 100%);
        color: var(--white);
    }

    .status-badge.rejected {
        background: linear-gradient(135deg, var(--danger) 0%, #d32f2f 100%);
        color: var(--white);
    }

    /* ===============================
       UTILITIES
    ================================== */
    .text-primary {
        color: var(--accent) !important;
    }

    .text-secondary {
        color: var(--gray) !important;
    }

    /* ===============================
       RESPONSIVE
    ================================== */
    @@media (max-width: 768px) {
    .page-header-wrapper {
        flex-direction: column;
        align-items: flex-start;
    }

    .page-header-wrapper h2 {
        font-size: 1.5rem;
    }

    .btn-back {
        width: 100%;
        justify-content: center;
    }

    .card img {
        max-width: 100%;
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    }

    @@media (max-width: 576px) {
    .card.p-4 {
        padding: 1rem !important;
    }

    .table thead th,
    .table tbody td {
        padding: 0.75rem;
        font-size: 0.8125rem;
    }
    }

    /* ===============================
       PRINT STYLES
    ================================== */
    @@media print {
        .page-header-wrapper {
            display: block;
        }

        .btn-back {
            display: none;
        }

        .card {
            box-shadow: none;
            page-break-inside: avoid;
        }
    }

</style>
<!-- Wrap the title and back button in a container -->
<div class="page-header-wrapper">
    <h2>
        <i class="fas fa-file-alt"></i>
        @ViewData["Title"]
    </h2>
    <a href="@Url.Action("Index", "ItemReport")" class="btn-back">
        <i class="fas fa-arrow-left"></i>
        Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm p-4 mb-4">
    <h4 class="mb-3">Chi tiết báo cáo</h4>

    <div class="mb-2"><strong>Loại báo cáo:</strong> @Model.Type.ToStringForType()</div>
    <div class="mb-2"><strong>Vật phẩm:</strong> @Model.OrderItem.ItemName</div>
    <div class="mb-2"><strong>Trạng thái:</strong> 
        @if (Model.Status == DataAccessLayer.Enums.ReportStatus.Pending)
        {
            <span class="badge bg-warning text-dark">Chờ xử lý</span>
        }
        else
        {
            <span class="badge bg-success">Đã xử lý</span>
        }
        </div>
    <div class="mb-2"><strong>Ngày báo cáo:</strong> @Model.ReportedAt.ToString("dd/MM/yyyy HH:mm")</div>
    <div class="mb-2"><strong>Số lượng thực tế:</strong> @Model.Quantity</div>
    <div class="mb-2"><strong>Mô tả chi tiết:</strong> @(Model.Description ?? "N/A")</div>
    <div class="mb-2"><strong>Ghi chú tình trạng:</strong> @(Model.ConditionNote ?? "N/A")</div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="mt-4">
            <h5>Ảnh minh chứng</h5>
            <img src="@Model.ImageUrl"
                 alt="Ảnh minh chứng"
                 class="img-fluid border rounded"
                 style="max-width: 400px; object-fit: cover;" />
        </div>
    }

    <hr class="my-4" />

    <div class="text-muted small">
        <div><strong>Mã báo cáo:</strong> @Model.Id</div>
        <div>
            <strong>Mã đơn hàng:</strong>
            <a href="@Url.Action("Detail", "Orders", new { id = Model.OrderItem.Order.Id })"
               class="text-decoration-none">
                #@Model.OrderItem.Order.Id.ToString().Substring(0, 8)
            </a>
        </div>
    </div>
</div>



@if (Model.Actions.Any())
{
    <div class="card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Lịch sử xử lý</h4>
            <button class="btn btn-sm btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#handleIncidentModal_@Model.Id">
                <i class="fas fa-plus-circle"></i> Tạo xử lý
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                <tr class="text-dark">
                    <th>Thời gian</th>
                    <th>Hành động</th>
                    <th>Ghi chú</th>
                    <th>Người xử lý</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var action in Model.Actions.OrderByDescending(a => a.ActionDate))
                {
                    <tr>
                        <td>@action.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@action.ActionType.ToDisplayString()</td>
                        <td>@(action.Note ?? "N/A")</td>
                        <td>@(action.Staff?.Role ?? "N/A")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm p-4 text-center">
        <h5 class="mb-3">Chưa có lịch sử xử lý nào.</h5>
        <button class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#handleIncidentModal_@Model.Id">
            <i class="fas fa-plus-circle"></i> Xử lý
        </button>
    </div>
}

<!-- Modal xử lý sự cố -->
        <div class="modal fade" id="handleIncidentModal_@Model.Id" tabindex="-1"
             aria-labelledby="incidentModalLabel_@Model.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="incidentModalLabel_@Model.Id">
                            Xử lý sự cố - @Model.OrderItem.ItemName
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <form id="handleIncidentForm_@Model.Id" enctype="multipart/form-data">
                            <!-- Hidden field -->
                            <input type="hidden" name="OrderItemId" value="@Model.OrderItem.Id"/>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Hành động xử lý</label>
                                <select name="ActionType" class="form-select" required>
                                    <option value="">-- Chọn hành động --</option>
                                    <option value="1">Hoàn trả hàng</option>
                                    <option value="2">Bồi thường</option>
                                    <option value="3">Đóng sự cố</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Ghi chú xử lý</label>
                                <textarea name="Note" class="form-control" rows="3"
                                          placeholder="Nhập ghi chú..."></textarea>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-primary"
                                        onclick="submitIncidentAction('@Model.Id')">
                                    <i class="fas fa-check"></i> Xác nhận xử lý
                                </button>
                                <button type="button" class="btn btn-secondary ms-2" data-bs-dismiss="modal">Hủy
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <script>
        async function submitIncidentAction(itemId) {
            const form = document.getElementById(`handleIncidentForm_${itemId}`);
            const formData = new FormData(form);

            const response = await fetch('/ItemReport/Actions', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                alert(result.message);
                const modalEl = document.getElementById(`handleIncidentModal_${itemId}`);
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();
                location.reload();
            } else {
                alert(result.message || 'Xảy ra lỗi khi xử lý sự cố.');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const selectAction = document.querySelector('select[name="ActionType"]');
            const noteField = document.querySelector('textarea[name="Note"]');

            if (!selectAction || !noteField) return;

            selectAction.addEventListener("change", function () {
                if (this.value === "2") { // Bồi thường
                    const total = @Model.OrderItem.Order.TotalAmount; // tổng tiền (vd: 1 triệu)
                    const percent = 0.5; // 50%
                    const compensation = total * percent;
                    noteField.value = `Bồi thường 50%, tương đương ${compensation.toLocaleString()}₫ của ${total.toLocaleString()}₫ theo đơn hàng và hợp đồng`;
                } else {
                    noteField.value = "";
                }
            });
        });
    </script>
}
