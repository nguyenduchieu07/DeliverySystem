@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("checkoutForm");
            if (!form) return;

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                
                if (!confirm("Bạn có chắc muốn xác nhận Check Out cho đơn hàng này không?")) {
                    return;
                }

                const formData = new FormData();
                const orderId = "@Model.Order.Id";
                formData.append("OrderId", orderId);

                const rows = form.querySelectorAll("tbody tr");
                rows.forEach((row, index) => {
                    const orderItemId = row.querySelector(`input[name="OrderItems[${index}].OrderItemId"]`)?.value;
                    const quantity = row.querySelector(`input[name="OrderItems[${index}].Quantity"]`)?.value;
                    const note = row.querySelector(`textarea[name="OrderItems[${index}].ConditionNote"]`)?.value;
                    const imageFile = row.querySelector(`input[name="OrderItems[${index}].Image"]`)?.files?.[0];

                    formData.append(`Items[${index}].OrderItemId`, orderItemId);
                    formData.append(`Items[${index}].Quantity`, quantity);
                    formData.append(`Items[${index}].ConditionNote`, note || "");
                    if (imageFile)
                        formData.append(`Items[${index}].Image`, imageFile);
                });

                try {
                    const response = await fetch("/Stores/Orders/CheckOutAll", {
                        method: "POST",
                        body: formData
                    });

                    const result = await response.json();
                    if (result.success) {
                        alert(result.message || "Xuất kho thành công!");
                        bootstrap.Modal.getInstance(document.getElementById("checkoutModal")).hide();
                        location.reload();
                    } else {
                        alert(result.message || "Có lỗi xảy ra!");
                    }
                } catch (err) {
                    console.error("Lỗi:", err);
                    alert("Không thể kết nối tới máy chủ.");
                }
            });
        });


        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("checkinForm");
            if (!form) return;

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                
                if (!confirm("Bạn có chắc muốn xác nhận Check In cho đơn hàng này không?")) {
                    return;
                }

                const formData = new FormData();
                const orderId = "@Model.Order.Id"; // Lấy OrderId từ ViewModel
                formData.append("OrderId", orderId);
                
                const rows = form.querySelectorAll("tbody tr");
                rows.forEach((row, index) => {
                    const orderItemId = row.querySelector(`input[name="OrderItems[${index}].OrderItemId"]`)?.value;
                    const quantity = row.querySelector(`input[name="OrderItems[${index}].Quantity"]`)?.value;
                    const note = row.querySelector(`textarea[name="OrderItems[${index}].ConditionNote"]`)?.value;
                    const imageInput = row.querySelector(`input[name="OrderItems[${index}].Image"]`);
                    const imageFile = imageInput?.files?.[0];

                    formData.append(`Items[${index}].OrderItemId`, orderItemId);
                    formData.append(`Items[${index}].Quantity`, quantity);
                    formData.append(`Items[${index}].ConditionNote`, note || "");

                    if (imageFile)
                        formData.append(`Items[${index}].Image`, imageFile);
                });

                try {
                    const response = await fetch("/Stores/Orders/CheckInAll", {
                        method: "POST",
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert(result.message || "Nhập kho thành công!");
                        bootstrap.Modal.getInstance(document.getElementById("checkinModal")).hide();
                        location.reload();
                    } else {
                        alert(result.message || "Có lỗi xảy ra!");
                    }
                } catch (err) {
                    console.error("Lỗi:", err);
                    alert("Không thể kết nối tới máy chủ.");
                }
            });
        });


        

        document.addEventListener('DOMContentLoaded', function () {
            const compensateCheckbox = document.querySelector('input[name="IsCompensated"]');
            const compensationInput = document.querySelector('input[name="CompensationAmount"]');

            // Ban đầu khóa input
            compensationInput.disabled = true;

            // Lắng nghe sự kiện thay đổi checkbox
            compensateCheckbox.addEventListener('change', function () {
                compensationInput.disabled = !this.checked;
                if (!this.checked) compensationInput.value = ''; // nếu bỏ tick thì xóa luôn giá trị
            });
        });
        document.addEventListener('DOMContentLoaded', function () {

            // Khi người dùng bấm nút "Tạo báo cáo"
            const reportModal = document.getElementById('createReportModal');
            reportModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const orderId = button.getAttribute('data-order-id');
                const itemId = button.getAttribute('data-item-id');

                // Gán giá trị vào input hidden
                document.getElementById('OrderIdInput').value = orderId;
                document.getElementById('OrderItemIdInput').value = itemId;
            });

            // Khi submit form
            const form = reportModal.querySelector('form');
            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                const formData = new FormData(form);

                const response = await fetch('/Stores/Orders/CreateReport', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    alert(result.message);
                    const modal = bootstrap.Modal.getInstance(reportModal);
                    modal.hide();
                    form.reset();
                    location.reload(); // Reload để thấy kết quả mới
                } else {
                    alert(result.message || 'Đã xảy ra lỗi.');
                    console.error(result.error);
                }
            });
        });


        //Chỉnh sửa đơn hàng
        $(document).ready(function () {
            // Mở modal
            $('#btnEditOrder').on('click', function () {
                $('#editOrderModal').modal('show');
            });

            // Lưu dữ liệu
            $('#btnSaveOrder').on('click', function () {
                const form = $('#editOrderForm');
                const formData = form.serialize();

                $.ajax({
                    url: '@Url.Action("UpdateOrder", "Orders", new { orderId = Model.Order.Id })',
                    type: 'PUT',
                    data: formData,
                    success: function (res) {
                        if (res.success) {
                            alert('Cập nhật đơn hàng thành công!');
                            location.reload();
                        } else {
                            alert('Lỗi: ' + res.message);
                        }
                    },
                    error: function () {
                        alert('Không thể gửi yêu cầu!');
                    }
                });
            });
        });

        //Chỉnh sửa ngày lưu kho
        $(function () {
            // Khi nhấn nút sửa
            $(".edit-slot-btn").on("click", function () {
                const slotId = $(this).data("slotid");
                const assigned = $(this).data("assigned");
                const released = $(this).data("released");

                $("#slotId").val(slotId);
                $("#assignedAt").val(assigned);
                $("#releasedAt").val(released);

                const modal = new bootstrap.Modal(document.getElementById("editSlotModal"));
                modal.show();
            });

            // Submit form cập nhật
            $("#editSlotForm").on("submit", function (e) {
                e.preventDefault();

                const data = {
                    slotId: $("#slotId").val(),
                    assignedAt: $("#assignedAt").val(),
                    releasedAt: $("#releasedAt").val()
                };

                $.ajax({
                    url: '@Url.Action("UpdateOrderWarehouseSlot", "Orders", new { orderId = Model.Order.Id })',
                    type: 'PUT',
                    data: data,
                    success: function (res) {
                        if (res.success) {
                            alert(res.message || "Cập nhật thành công!");
                            $("#editSlotModal").modal("hide");
                            location.reload();
                        } else {
                            alert("⚠️ " + (res.message || "Có lỗi xảy ra."));
                        }
                    },
                    error: function (xhr) {
                        alert("❌ Lỗi máy chủ: " + xhr.statusText);
                    }
                });
            });
        });
    </script>
}
