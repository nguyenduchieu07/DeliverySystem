@foreach (var item in Model.Order.OrderItems)
{
    if (item.IncidentReports.OrderByDescending(x => x.CreatedAt).ToList().Count > 0)
    {
        
        
        <div class="modal fade" id="incidentModal_@item.Id" tabindex="-1">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Báo cáo - @item.ItemName
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        @foreach (var report in item.IncidentReports)
                        {
                            <div class="border rounded p-3 mb-4">

                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">Mã báo cáo: <code>@report.Id.ToString().Substring(0, 8)</code></span>
                                    <span
                                        class="badge bg-@(report.Status == ReportStatus.Pending ? "warning" : "success")">
                                        @report.Status
                                    </span>
                                </div>

                                @if (report.Status != ReportStatus.CheckIn && report.Status != ReportStatus.CheckOut)
                                {
                                    <p class="mb-1"><strong>Loại báo cáo</strong> @report.Type.ToStringForType()</p>
                                }
                                <p class="mb-1"><strong>Mô tả:</strong> @report.Description</p>

                                @if (!string.IsNullOrEmpty(report.ImageUrl))
                                {
                                    <div class="mb-2">
                                        <strong>Ảnh minh chứng:</strong><br/>
                                        <img src="@report.ImageUrl" class="img-thumbnail mt-2"
                                             style="max-width: 200px"/>
                                    </div>
                                }

                                <p class="mb-1">
                                    <strong>
                                        Ngày báo
                                        cáo:
                                    </strong> @report.ReportedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>

                                @if (report.IsReturned || report.IsCompensated)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-info">Đã xử lý</span>
                                        @if (report.IsReturned)
                                        {
                                            <span class="badgey">Đã hoàn/ký gửi hàng</span>
                                        }
                                        @if (report.IsCompensated)
                                        {
                                            <span
                                                class="badge bg-success">Đã bồi thường @report.CompensationAmount?.ToString("N0") VNĐ</span>
                                        }
                                    </div>
                                }

                                <!-- Hiển thị lịch sử xử lý -->
                                @if (report.Actions.Any())
                                {
                                    <div class="mt-3">
                                        <h6>Lịch sử xử lý</h6>
                                        <table class="table table-sm table-bordered">
                                            <thead>
                                            <tr>
                                                <th>Thao tác</th>
                                                <th>Ghi chú</th>
                                                <th>Ngày thực hiện</th>
                                                <th>Nhân viên</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var action in report.Actions.OrderByDescending(x => x.ActionDate))
                                            {
                                                <tr>
                                                    <td>
                                                        @(
                                                        action.ActionType switch
                                                        {
                                                            ItemReportActionType.ConfirmDamage => "Xác nhận hư hỏng",
                                                            ItemReportActionType.ReturnItem => "Hoàn trả hàng",
                                                            ItemReportActionType.Compensate => "Đền bù",
                                                            ItemReportActionType.Close => "Đóng khiếu nại",
                                                            _ => action.ActionType.ToString()
                                                        }
                                                        )
                                                    </td>
                                                    <td>@action.Note</td>
                                                    <td>@action.ActionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@(action.Staff?.Role ?? "N/A")</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    if (report.Status != ReportStatus.CheckIn && report.Status != ReportStatus.CheckOut)
                                    {
                                        <p class="text-muted fst-italic mt-2">Chưa có hành động xử lý nào.</p>
                                    }
                                }
                            </div>
                        }
                    </div>


                </div>
            </div>
        </div>
    }
}
