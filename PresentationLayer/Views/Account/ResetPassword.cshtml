@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu - VCN Vietnam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/vcn-auth.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="background-illustration">
        <div class="vehicle car1 animated" style="--rotation: -15deg;"></div>
        <div class="vehicle van1 animated" style="--rotation: -10deg;"></div>
        <div class="vehicle truck1 animated" style="--rotation: -20deg;"></div>
        <div class="vehicle car2 animated" style="--rotation: -25deg;"></div>
        <div class="vehicle van2 animated" style="--rotation: -5deg;"></div>
        <div class="vehicle truck2 animated" style="--rotation: -15deg;"></div>
    </div>
    
    <div class="login-container">
        <div class="login-logo">
            <div class="login-logo-text">
                <div class="login-logo-icon"></div>
                VCN
            </div>
        </div>
        
        <h2 class="auth-title">Đặt lại mật khẩu</h2>
        <p class="auth-subtitle">Nhập mật khẩu mới cho tài khoản của bạn.</p>
        
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert-danger">
                @Html.ValidationSummary(false)
            </div>
        }
        
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetPasswordForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.Code)
            
            <div class="login-form-group">
                <div class="password-field">
                    @Html.PasswordFor(m => m.NewPassword, new { 
                        @class = "password-input", 
                        @placeholder = "Mật khẩu mới",
                        @id = "newPasswordField"
                    })
                    <button type="button" class="password-toggle-btn" onclick="togglePassword('newPasswordField')">👁</button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })
            </div>
            
            <div class="login-form-group">
                <div class="password-field">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { 
                        @class = "password-input", 
                        @placeholder = "Xác nhận mật khẩu",
                        @id = "confirmPasswordField"
                    })
                    <button type="button" class="password-toggle-btn" onclick="togglePassword('confirmPasswordField')">👁</button>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
            </div>
            
            <button type="submit" class="login-submit-btn" id="resetPasswordBtn">
                Đặt lại mật khẩu
            </button>
        }
        
        <div class="signup-section">
            <a href="@Url.Action("Login", "Account")" style="color: #f26722; text-decoration: none; font-weight: 600;">
                ← Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>

<script>
    function togglePassword(fieldId) {
        const passwordInput = document.getElementById(fieldId);
        const toggleBtn = passwordInput.nextElementSibling;
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleBtn.textContent = '🙈';
        } else {
            passwordInput.type = 'password';
            toggleBtn.textContent = '👁';
        }
    }
    
    document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
        const btn = document.getElementById('resetPasswordBtn');
        btn.textContent = 'Đang xử lý...';
        btn.disabled = true;
    });
    
    window.addEventListener('load', function() {
        const btn = document.getElementById('resetPasswordBtn');
        btn.textContent = 'Đặt lại mật khẩu';
        btn.disabled = false;
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
