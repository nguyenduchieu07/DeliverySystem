@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu - VCN Vietnam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/vcn-auth.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="background-illustration">
        <div class="vehicle car1 animated" style="--rotation: -15deg;"></div>
        <div class="vehicle van1 animated" style="--rotation: -10deg;"></div>
        <div class="vehicle truck1 animated" style="--rotation: -20deg;"></div>
        <div class="vehicle car2 animated" style="--rotation: -25deg;"></div>
        <div class="vehicle van2 animated" style="--rotation: -5deg;"></div>
        <div class="vehicle truck2 animated" style="--rotation: -15deg;"></div>
    </div>
    
    <div class="login-container">
        <div class="login-logo">
            <div class="login-logo-text">
                <div class="login-logo-icon"></div>
                VCN
            </div>
        </div>
        
        <h2 class="auth-title">Quên mật khẩu</h2>
        <p class="auth-subtitle">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
        
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert-success">
                @ViewBag.SuccessMessage
            </div>
        }
        
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert-danger">
                @Html.ValidationSummary(false)
            </div>
        }
        
        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotPasswordForm" }))
        {
            @Html.AntiForgeryToken()
            
            <div class="login-form-group">
                @Html.TextBoxFor(m => m.Email, new { 
                    @class = "phone-email-input", 
                    @placeholder = "Email của bạn",
                    @type = "email"
                })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>
            
            <button type="submit" class="login-submit-btn" id="forgotPasswordBtn">
                Gửi yêu cầu
            </button>
        }
        
        <div class="signup-section">
            <a href="@Url.Action("Login", "Account")" style="color: #f26722; text-decoration: none; font-weight: 600;">
                ← Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>

<script>
    document.getElementById('forgotPasswordForm').addEventListener('submit', function(e) {
        const btn = document.getElementById('forgotPasswordBtn');
        btn.textContent = 'Đang gửi...';
        btn.disabled = true;
    });
    
    window.addEventListener('load', function() {
        const btn = document.getElementById('forgotPasswordBtn');
        btn.textContent = 'Gửi yêu cầu';
        btn.disabled = false;
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
